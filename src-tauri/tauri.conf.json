{
  "productName": "Socratic Citation Coach",
  "version": "0.1.0",
  "identifier": "sg.edu.sit.socratic-citation-coach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Socratic Citation Coach",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "dragDropEnabled": false,
        "theme": "Light",
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Singapore Institute of Technology",
    "category": "Education",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Citation reasoning coach for capstone students",
    "longDescription": "Local-first Socratic coach that helps students justify literature review citations and produces an auditable reasoning trace for faculty supervisors.",
    "copyright": "Singapore Institute of Technology capstone toolkit"
  }
}
